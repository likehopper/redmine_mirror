Render project-scoped Mirror controls and diagnostics using native Redmine helpers.
%><h2><%= l(:label_mirror_sync_history) %> #<%= @run.id %></h2>
<p><%= link_to l(:button_back), mirror_page_path(@project, "history") %></p>
<p><%= l(:field_status) %>: <strong><%= l("label_mirror_run_#{@run.status}".to_sym) %></strong></p>
<%= render "mirror/queued_run", run: @run if @run.status == "queued" %>
<%= render "mirror/running_run", run: @run if @run.status == "running" %>
<p><%= l(:label_mirror_sync_started) %>: <%= @run.started_at ? format_time(@run.started_at) : "—" %></p>
<p><%= l(:label_mirror_sync_finished) %>: <%= @run.finished_at ? format_time(@run.finished_at) : "—" %></p>
<%# A stop asked for from the Mirror page is not a failure: say who stopped it. %>
<% if @run.stopped_on_request? %>
  <p class="info" id="mirror-stopped-by"><%= l(:text_mirror_stopped_by, time: format_time(@run.stop_requested_at), user: @run.stop_requested_by&.name || "—") %></p>
<% elsif @run.error_message.present? %><p><%= link_to l(:label_mirror_conflicts), mirror_page_path(@project, "attention", anchor: "mirror-conflicts-section") %></p><div class="flash error"><%= mirror_reason_label(@run.error_message) %></div><% end %>
<%= render "mirror/run_progress", run: @run if %w[queued running].include?(@run.status) %>
<% tabs = [{ name: "summary", partial: "mirror_synchronizations/run_summary", label: :label_mirror_run_summary }]
   tabs << { name: "attention", partial: "mirror_synchronizations/run_attention", label: :label_mirror_to_check } if @error_groups.any? || @warning_counts.any? || @flag_counts.any?
   tabs << { name: "log", partial: "mirror_synchronizations/run_log", label: :label_mirror_log } %>
<%= render_tabs tabs, @tab %>
