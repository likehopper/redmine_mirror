One Mirror source session: each request, served or refused, and what it sent.
%><% if accesses.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
  <table class="list mirror-source-accesses">
    <thead><tr>
      <th><%= l(:label_mirror_source_time) %></th>
      <th><%= l(:label_mirror_source_account) %></th>
      <th><%= l(:label_mirror_source_address) %></th>
      <th><%= l(:label_mirror_source_request) %></th>
      <th><%= l(:label_mirror_source_sent) %></th>
    </tr></thead>
    <tbody>
      <% accesses.each do |access| %>
        <% details = access.details %>
        <tr class="<%= 'mirror-source-refused' if access.action == 'refused' %>">
          <td><%= format_time(access.created_at) %></td>
          <td><%= access.user ? link_to_user(access.user) : l(:label_user_anonymous) %></td>
          <td><%= access.remote_ip %></td>
          <td><%= l("label_mirror_source_action_#{access.action}".to_sym) %></td>
          <td>
            <% case access.action %>
            <% when "refused" %>
              <%= l("text_mirror_source_refusal_#{access.reason}".to_sym, default: access.reason.to_s) %>
            <% when "download" %>
              <% file = details.fetch("attachment", {}) %>
              <%= file["filename"] %> (<%= number_to_human_size(access.bytes) %>)
            <% else %>
              <% if (tags = details["issue_tags"]).is_a?(Hash) %>
                <strong><%= l(:label_mirror_module_issue_tags) %></strong> <%= l(:text_mirror_source_tags_listed, issues: tags["issues"].to_i, tags: tags["tags"].to_i) %>
              <% end %>
              <% if (scrum = details["scrum"]).is_a?(Hash) %>
                <strong><%= l(:label_mirror_module_scrum) %></strong> <%= l(:text_mirror_source_scrum_listed, sprints: scrum["sprints"].to_i, issues: scrum["issues"].to_i) %>
              <% end %>
              <% %w[documents news].each do |kind| %>
                <% next if details.fetch(kind, []).empty? %>
                <strong><%= l("label_mirror_module_#{kind}".to_sym) %></strong> <%= safe_join(details.fetch(kind).map { |row| "#{row['title']} (##{row['id']})" }, ", ") %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
