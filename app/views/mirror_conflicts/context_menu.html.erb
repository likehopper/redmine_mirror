Context menu of the selected conflicts: each resolution applies to all of them.
%><% ids = @conflicts.map(&:id) %>
<ul>
  <li><%= context_menu_link l(:button_mirror_take_source), project_mirror_conflicts_bulk_update_path(@project, ids: ids, resolution: "source", back_url: @back),
        method: :patch, data: { confirm: l(:text_mirror_take_source_confirm, count: ids.size) }, class: "icon icon-reload" %></li>
  <li><%= context_menu_link l(:button_mirror_keep_local), project_mirror_conflicts_bulk_update_path(@project, ids: ids, resolution: "ignore", back_url: @back),
        method: :patch, data: { confirm: l(:text_mirror_keep_local_confirm) }, class: "icon icon-lock",
        disabled: @conflicts.none?(&:destination_id) %></li>
  <li><%= context_menu_link l(:button_mirror_recheck), project_mirror_conflicts_bulk_update_path(@project, ids: ids, resolution: "recheck", back_url: @back),
        method: :patch, class: "icon icon-checked" %></li>
</ul>
