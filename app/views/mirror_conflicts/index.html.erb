The project's conflicts as a Redmine query, with a context menu to resolve several at once.
%><% content_for :header_tags do %>
  <%= stylesheet_link_tag "mirror", plugin: "redmine_mirror" %>
<% end %>
<% html_title(l(:label_mirror_conflicts), l(:label_mirror)) %>
<h2><%= link_to l(:label_mirror), project_mirror_path(@project) %> » <%= l(:label_mirror_conflicts) %></h2>
<p class="info"><%= l(:text_mirror_conflicts) %></p>

<%= form_tag(project_mirror_conflicts_path(@project), method: :get, id: "query_form") do %>
  <%= render partial: "queries/query_form" %>
<% end %>

<% if @query.valid? %>
  <% if @conflicts.empty? %>
    <p class="nodata"><%= l(:label_no_data) %></p>
  <% else %>
    <%= render partial: "mirror_conflicts/list", locals: { conflicts: @conflicts } %>
    <span class="pagination"><%= pagination_links_full @conflict_pages, @conflict_count %></span>
  <% end %>
<% end %>
<%= context_menu if mirror_can_run?(@project) %>
