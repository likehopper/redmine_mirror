Rows of the conflicts query; with the run permission, rows can be selected for the context menu.
%><% selectable = mirror_can_run?(@project) %>
<%= form_tag({}, id: "mirror-conflicts-form", data: { cm_url: project_mirror_conflicts_context_menu_path(@project) }) do %>
<%= hidden_field_tag "back_url", url_for(params: request.query_parameters), id: nil %>
<div class="autoscroll">
<table class="list odd-even" id="mirror-conflicts">
<thead><tr>
  <% if selectable %>
    <th class="checkbox hide-when-print"><%= check_box_tag "check_all", "", false, class: "toggle-selection", title: "#{l(:button_check_all)}/#{l(:button_uncheck_all)}" %></th>
  <% end %>
  <% @query.inline_columns.each do |column| %><%= column_header(@query, column) %><% end %>
  <% if selectable %><th></th><% end %>
</tr></thead>
<tbody>
<% grouped_query_results(conflicts, @query) do |conflict, group_name, group_count, group_totals| %>
  <% if group_name %>
    <% reset_cycle %>
    <tr class="group open"><td colspan="<%= @query.inline_columns.size + (selectable ? 2 : 0) %>">
      <span class="expander icon icon-expanded" onclick="toggleRowGroup(this);">&nbsp;</span>
      <span class="name"><%= group_name %></span>
      <% if group_count %><span class="badge badge-count count"><%= group_count %></span><% end %>
      <%= link_to_function("#{l(:button_collapse_all)}/#{l(:button_expand_all)}", "toggleAllRowGroups(this)", class: "toggle-all") %>
    </td></tr>
  <% end %>
  <tr id="mirror-conflict-<%= conflict.id %>" class="<%= cycle("odd", "even") %> <%= "hascontextmenu" if selectable %>">
    <% if selectable %>
      <td class="checkbox hide-when-print"><%= check_box_tag "ids[]", conflict.id, false, id: nil %></td>
    <% end %>
    <% @query.inline_columns.each do |column| %>
      <%= content_tag("td", mirror_conflict_column_content(column, conflict), class: column.css_classes) %>
    <% end %>
    <% if selectable %><td class="buttons hide-when-print"><%= link_to_context_menu %></td><% end %>
  </tr>
<% end %>
</tbody>
</table>
</div>
<% end %>
