The project's Mirror page: overview, history, items requiring attention and synchronized objects.
%><% content_for :header_tags do %>
  <%= stylesheet_link_tag "mirror", plugin: "redmine_mirror" %>
  <%= javascript_include_tag "mirror", plugin: "redmine_mirror" %>
<% end %>
<% if mirror_manager?(@project) %>
  <div class="contextual"><%= link_to l(:label_mirror_configure), mirror_configuration_path(@project), class: "icon icon-settings" %></div>
<% end %>
<h2><%= l(:label_mirror) %></h2>
<% if @setting.nil? %>
  <p id="mirror-not-configured"><%= l(:text_mirror_not_configured) %></p>
  <% if mirror_manager?(@project) %>
    <%= render "mirror/setup", steps: mirror_setup_steps(@project, nil) %>
  <% else %>
    <p><%= l(:text_mirror_not_configured_ask) %></p>
  <% end %>
<% else %>
  <% attention_count = @open_conflict_count + @pending_count + @pending_parent_count %>
  <% tabs = [["overview", l(:label_mirror_overview)], ["history", l(:label_mirror_sync_history)],
             ["attention", attention_count.positive? ? l(:label_mirror_attention_count, count: attention_count) : l(:label_mirror_attention)]] %>
  <% tabs << ["objects", l(:label_mirror_objects)] %>
  <div class="mirror-tabs"><div class="tabs" id="mirror-page-tabs"><ul>
    <% tabs.each do |key, label| %>
      <li><%= link_to label, mirror_page_path(@project, key == "overview" ? nil : key), class: (@tab == key ? "selected" : nil) %></li>
    <% end %>
  </ul></div></div>
  <%= render "mirror/#{@tab}" %>
<% end %>
<% html_title(l(:label_mirror)) %>
