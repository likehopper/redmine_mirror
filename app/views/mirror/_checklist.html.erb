What needs checking, from the source references read last: each item with its links
and one-click fixes (Mirror settings, fix_setup), which come back to this page.
%><div class="box" id="mirror-checklist"><h3><%= l(:label_mirror_checklist) %></h3>
  <p class="info"><%= l(:text_mirror_checklist) %></p>
  <ul><% checklist.each do |item| %><li><%= item[:text] %>
    <%= safe_join(item[:actions].map { |label, path| link_to(label, path, class: "mirror-fix") }, " · ") %>
    <% item[:buttons].each do |label, fix| %>
      <%= button_to label, project_mirror_fix_path(@project), params: fix.merge(back_url: request.fullpath), method: :post,
            form_class: "mirror-inline-form mirror-fix-form", class: "mirror-fix-button", data: { fix: fix[:fix] } %>
    <% end %></li><% end %></ul>
</div>
