Getting started: the steps from connection to the first synchronization, each linked to its page.
%><div class="box" id="mirror-setup">
  <h3><%= l(:label_mirror_setup) %></h3>
  <% current = steps.find { |step| step[1] != :done }&.first %>
  <ol class="mirror-steps">
    <% steps.each do |key, state, detail, path| %>
      <li class="mirror-step mirror-step-<%= state %><%= ' mirror-step-current' if key == current %>" id="mirror-step-<%= key %>">
        <span class="mirror-step-state"><%= l("label_mirror_step_state_#{state}") %></span>
        <% allowed = %i[connection references mappings schedule].include?(key) ? mirror_manager?(@project) : mirror_can_run?(@project) %>
        <strong><%= allowed && key == current ? link_to(l("label_mirror_step_#{key}"), path) : l("label_mirror_step_#{key}") %></strong>
        <span class="mirror-step-help"><%= l("text_mirror_step_#{key}") %></span>
        <% if detail %><span class="mirror-step-detail"><%= detail %></span><% end %>
      </li>
    <% end %>
  </ol>
</div>
