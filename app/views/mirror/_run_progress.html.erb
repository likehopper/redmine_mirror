Live progress of a running execution: phase, overall bar, then each module with its state
and counters. The page reloads itself while the execution runs (mirror.js).
%><% summary = mirror_progress_summary(run.live_progress) %>
<div class="box" id="mirror-run-progress" data-mirror-reload="5">
<% if summary %>
  <p><strong><%= l("label_mirror_phase_#{summary[:phase]}", default: summary[:phase].to_s) %></strong> —
    <%= l(:text_mirror_module_position, position: summary[:position], count: summary[:count]) %></p>
  <p><progress value="<%= summary[:percentage] %>" max="100"></progress> <%= summary[:percentage] %>%</p>
  <table class="list" id="mirror-run-modules"><thead><tr><th><%= l(:label_mirror_modules) %></th><th><%= l(:field_status) %></th><th><%= l(:label_mirror_objects_handled) %></th></tr></thead><tbody>
  <% summary[:modules].each do |entry| %>
    <% total = entry["total"] && entry["done"] <= entry["total"] ? entry["total"] : nil %>
    <tr class="<%= 'mirror-module-running' if entry['state'] == 'running' %>"><td><%= mirror_module_label(entry["key"]) %></td>
      <td><%= l("label_mirror_module_state_#{entry['state']}", default: entry["state"].to_s) %></td>
      <td><%= entry["state"] == "waiting" ? "—" : (total ? "#{entry['done']} / #{total}" : entry["done"]) %></td></tr>
  <% end %>
  </tbody></table>
<% else %>
  <p><%= run.status == "queued" ? l(:label_mirror_run_queued) : l(:text_mirror_objects_checked, count: run.processed_records) %></p>
<% end %>
</div>
