A running execution: a button to stop it, then the pending request until the worker,
or the next tick when that worker is gone, ends it (Synchronization.cancel).
%><div id="mirror-running-run">
  <% if run.stop_requested? %>
    <p class="warning" id="mirror-stop-requested"><%= l(:text_mirror_stop_requested, time: format_time(run.stop_requested_at), user: run.stop_requested_by&.name || "—") %></p>
  <% elsif mirror_can_run?(@project) %>
    <%= button_to l(:button_mirror_stop_run), project_mirror_run_cancel_path(@project, run), method: :patch,
          data: { confirm: l(:text_mirror_stop_confirm) } %>
  <% end %>
</div>
