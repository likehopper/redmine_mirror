Group operational items that require a decision or another project synchronization.
%><section id="mirror-conflicts-section">
  <h3><%= l(:label_mirror_conflicts) %></h3>
  <%= render "mirror/conflicts" %>
</section>
<section id="mirror-pending-section">
  <%= form_tag project_mirror_path(@project), method: :get do %>
    <%= hidden_field_tag :tab, "attention" %>
    <%= hidden_field_tag :conflict_status, @conflict_status %>
    <%= label_tag :pending_status, l(:field_status), class: "hidden-for-sighted" %>
    <%= select_tag :pending_status, options_for_select([[l(:label_all), ""], [l(:label_mirror_relation_pending), "pending"], [l(:label_mirror_relation_blocked), "blocked"]], params[:pending_status]) %>
    <%= submit_tag l(:button_apply) %>
  <% end %>
  <%= render "mirror/pending_relations" %>
  <%= render "mirror/pending_parents" %>
</section>
