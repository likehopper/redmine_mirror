# The project's repositories; login and password only when credentials are shared.

api.array :repositories, api_meta(total_count: @repositories.size) do
  @repositories.each do |repository|
    api.repository do
      api.id repository.id
      api.scm repository.scm_name
      api.identifier repository.identifier.to_s
      api.is_default repository.is_default?
      api.url repository.url
      api.root_url repository.root_url
      api.path_encoding repository.path_encoding
      api.log_encoding repository.log_encoding
      api.report_last_commit(repository.extra_info.is_a?(Hash) ? repository.extra_info["extra_report_last_commit"] : nil)
      api.changesets_count Changeset.where(repository_id: repository.id).count
      if @credentials
        api.login repository.login
        api.password repository.password
      end
    end
  end
end
