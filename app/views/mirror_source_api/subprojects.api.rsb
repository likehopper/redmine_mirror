#
# The subprojects running Mirror source that the account can see, in tree order, with
# their parent and modules.

api.array :subprojects, api_meta(total_count: @subprojects.size) do
  @subprojects.each do |child|
    api.project do
      api.id child.id
      api.identifier child.identifier
      api.name child.name
      api.parent_id child.parent_id
      api.status child.status
      api.array :enabled_modules do
        child.enabled_module_names.each { |name| api.module name }
      end
    end
  end
end
