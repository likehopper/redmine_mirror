#
# The project's own categories: the stored name (a plugin may decorate `name` with the
# project), the default assignee and, when this Redmine has it, the sharing.

api.array :issue_categories, api_meta(total_count: @categories.size) do
  @categories.each do |category|
    api.issue_category do
      api.id category.id
      api.name category[:name]
      api.assigned_to(id: category.assigned_to_id, name: category.assigned_to.name) if category.assigned_to
      api.sharing(category[:sharing].presence || "none") if @sharing
    end
  end
end
