#
# One enumeration, so that a destination in mirror mode can confirm a deletion.

api.project_enumeration do
  enumeration = @enumeration
  api.project(id: @project.id, name: @project.name)
  api.id enumeration.id
  api.custom_field(id: enumeration.custom_field_id, name: enumeration.custom_field&.name, field_format: enumeration.custom_field&.field_format,
    type: enumeration.custom_field&.type)
  api.value enumeration.value
  api.status enumeration.status
  api.sharing enumeration.sharing
  api.position enumeration.position
end
