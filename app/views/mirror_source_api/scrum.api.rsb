# Scrum plugin data of the project: sprints (product backlogs included), then issues.

api.scrum do
  api.array :sprints do
    @sprints.each do |sprint|
      api.sprint do
        api.id sprint.id
        api.name sprint.name
        api.description sprint.description
        api.start_date sprint.sprint_start_date
        api.end_date sprint.sprint_end_date
        api.status sprint.status
        api.shared sprint.shared?
        api.product_backlog sprint.is_product_backlog?
        api.created_on sprint.created_on
      end
    end
  end
  api.array :issues do
    @scrum_issues.each do |id, sprint_id, position, story_points|
      api.issue do
        api.id id
        api.sprint_id sprint_id
        api.position position
        api.story_points story_points
      end
    end
  end
end
