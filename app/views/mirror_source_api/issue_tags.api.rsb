#
# The tag names of every visible issue of the project, sorted.

api.array :issue_tags, api_meta(total_count: @issue_tags.size) do
  @issue_tags.each do |id, tags|
    api.issue do
      api.id id
      api.array(:tags) { tags.each { |name| api.tag name } }
    end
  end
end
