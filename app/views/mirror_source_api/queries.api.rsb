# Saved queries of the project with their full definition, as plain JSON values.

api.array :queries, api_meta(total_count: @queries.size) do
  @queries.each do |query|
    api.query do
      api.id query.id
      api.type query.type
      api.name query.name
      api.visibility query.visibility
      api.user(id: query.user_id, name: query.user.name) if query.user
      api.array(:roles) { query.roles.each { |role| api.role(id: role.id, name: role.name) } }
      api.filters RedmineMirror::Source.plain(query.filters || {})
      api.column_names RedmineMirror::Source.plain(query.read_attribute(:column_names) || [])
      api.sort_criteria RedmineMirror::Source.plain(query.read_attribute(:sort_criteria) || [])
      api.group_by query.group_by
      api.options RedmineMirror::Source.plain(query.options || {})
    end
  end
end
