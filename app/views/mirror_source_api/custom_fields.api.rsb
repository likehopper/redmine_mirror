#
# Project-visible issue custom field definitions, without issue values.

api.array :custom_fields, api_meta(total_count: @custom_fields.size) do
  @custom_fields.each do |field|
    api.custom_field do
      api.id field.id
      api.name field.name
      api.customized_type "issue"
      api.field_format field.field_format
      api.multiple field.multiple?
      api.array :possible_values do
        field.possible_values_options.each do |label, value|
          api.possible_value do
            api.value((value || label).to_s)
            api.label label.to_s
          end
        end
      end
    end
  end
end
