# One page of a repository's changeset-issue links: revision and source issue IDs.

api.repository_links do
  api.total_count @total
  api.offset @offset
  api.array :links do
    @links.each do |revision, issue_ids|
      api.link do
        api.revision revision
        api.array(:issue_ids) { issue_ids.each { |id| api.id id } }
      end
    end
  end
end
