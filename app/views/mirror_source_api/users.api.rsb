#
# The requested users the project knows, with what a destination needs to create or
# recognize their account: login, names, email, company and status.

api.array :users, api_meta(total_count: @users.size) do
  @users.each do |user|
    api.user do
      api.id user.id
      api.login user.login
      api.firstname user.firstname
      api.lastname user.lastname
      api.mail user.mail
      api.company(@company_field ? user.custom_field_value(@company_field).to_s.presence : nil)
      api.status user.status
    end
  end
end
