Render project-scoped Mirror controls and diagnostics using native Redmine helpers.
%><% content_for :header_tags do %>
  <%= stylesheet_link_tag "mirror", plugin: "redmine_mirror" %>
  <%= javascript_include_tag "mirror", plugin: "redmine_mirror" %>
<% end %>
<h2><%= l(:label_mirror_settings) %></h2>
<%= error_messages_for @setting %>
<% if @setting.persisted? && @setting.catalog_refreshing? %>
  <p class="warning" id="mirror-catalog-status"><%= l(:text_mirror_catalog_refreshing, time: format_time(@setting.catalog_requested_at)) %>
    <% if (progress = @setting.catalog_progress).any? %>
      <br><%= l(:text_mirror_catalog_progress, step: progress["step"], steps: progress["steps"], module: mirror_module_label(progress["module"]), records: progress["records"], time: format_time(Time.iso8601(progress["at"]))) %>
    <% end %></p>
<% elsif @setting.persisted? && @setting.catalog_status == "failed" %>
  <div class="flash error" id="mirror-catalog-status"><%= l(:text_mirror_catalog_failed, error: @setting.catalog_error) %></div>
<% end %>
<% module_section = @tab == "objects" || @adapters.any? { |adapter| adapter.key == @tab } %>
<div id="mirror-settings-tabs">
<div class="tabs" id="mirror-settings-sections"><ul>
<li><%= link_to l(:label_mirror_sync_configuration), project_mirror_settings_path(@project), class: (!module_section ? "selected" : nil) %></li>
<% if @setting.persisted? %>
<li><%= link_to l(:label_mirror_module_configuration), project_mirror_settings_path(@project, tab: @adapters.first&.key || "objects"), class: (module_section ? "selected" : nil) %></li>
<% end %>
</ul></div>
<div class="tabs" id="mirror-settings-subtabs"><ul>
<% if module_section %>
  <% @adapters.each do |adapter| %>
    <li><%= link_to l(adapter.label), project_mirror_settings_path(@project, tab: adapter.key), class: (@tab == adapter.key ? "selected" : nil) %></li>
  <% end %>
  <li><%= link_to l(:label_mirror_objects), project_mirror_settings_path(@project, tab: "objects"), class: (@tab == "objects" ? "selected" : nil) %></li>
<% else %>
  <li><%= link_to l(:label_mirror_connection), project_mirror_settings_path(@project), class: (@tab == "connection" ? "selected" : nil) %></li>
  <% if @setting.persisted? %>
    <li><%= link_to l(:label_mirror_synchronization), project_mirror_settings_path(@project, tab: "synchronization"), class: (@tab == "synchronization" ? "selected" : nil) %></li>
    <li><%= link_to l(:label_mirror_conflicts), project_mirror_settings_path(@project, tab: "conflicts"), class: (@tab == "conflicts" ? "selected" : nil) %></li>
    <li><%= link_to l(:label_mirror_sync_history), project_mirror_settings_path(@project, tab: "history"), class: (@tab == "history" ? "selected" : nil) %></li>
  <% end %>
<% end %>
</ul></div>
</div>
<% if @tab == "connection" %>
  <p><%= l(:text_mirror_connection_admin) %></p>
  <%= form_tag project_mirror_connection_path(@project), method: :patch do %>
    <div class="box tabular">
      <p><%= label_tag "connection_source_url", l(:label_mirror_source_url) %><%= text_field_tag "connection[source_url]", @setting.source_url, size: 60, disabled: !User.current.admin? %></p>
      <p><%= label_tag "connection_source_project_id", l(:label_mirror_source_project) %><%= text_field_tag "connection[source_project_id]", @setting.source_project_identifier.presence || @setting.source_project_id, size: 30, disabled: !User.current.admin? %>
        <% if @setting.source_project_id %><em class="info"><%= l(:text_mirror_source_project_number, id: @setting.source_project_id) %></em><% end %></p>
      <p><%= label_tag "connection_source_text_format", l(:label_mirror_source_text_format) %>
        <%= select_tag "connection[source_text_format]", options_for_select(RedmineMirror::TextFormat::SOURCE_FORMATS.map { |format| [l("label_mirror_text_format_#{format}"), format] }, @setting.source_text_format),
              id: "connection_source_text_format", disabled: !User.current.admin? %>
        <em class="info" id="mirror-text-formats"><%= l(:text_mirror_destination_text_format, name: RedmineMirror::TextFormat.destination_format(@project).presence || "—") %>
          <% if (counts = @setting.source_catalog["text_formats"]).present? %>
            <%= l(:text_mirror_detected_text_formats, formats: counts.sort_by { |_, count| -count.to_i }.map { |format, count| "#{l("label_mirror_text_format_#{format}")} #{count}" }.join(", ")) %>
          <% end %></em></p>
      <% if User.current.admin? %>
        <p><%= label_tag "connection_api_key", l(:label_mirror_api_key) %><%= password_field_tag "connection[api_key]", nil, autocomplete: "new-password" %><em class="info"><%= l(:text_mirror_keep_api_key) %></em></p>
      <% end %>
      <p><label><%= l(:label_mirror_modules) %></label>
        <%= hidden_field_tag "connection[modules][]", "" %>
        <% RedmineMirror::REGISTRY.resolve(RedmineMirror::REGISTRY.keys).select(&:selectable?).each do |adapter| %>
          <% next unless adapter.available? || @setting.selected_modules.include?(adapter.key) %>
          <label class="block"><%= check_box_tag "connection[modules][]", adapter.key, @setting.selected_modules.include?(adapter.key), disabled: !User.current.admin? %> <%= l(adapter.label) %></label>
        <% end %>
      </p>
      <% if @setting.unavailable_modules.any? %>
        <p id="mirror-unavailable-modules" class="warning"><%= l(:text_mirror_unavailable_modules, modules: @setting.unavailable_modules.map { |key| mirror_module_label(key) }.join(", ")) %></p>
      <% end %>
    </div>
    <% if User.current.admin? %><%= submit_tag l(:button_save) %><% end %>
  <% end %>
  <% if @setting.persisted? && User.current.admin? %>
    <%= button_to l(:button_mirror_refresh), project_mirror_refresh_path(@project), method: :post %>
  <% end %>
<% elsif @tab == "objects" %>
  <%= render "objects" %>
<% elsif @tab == "conflicts" %>
  <%= render "conflicts" %>
<% elsif @tab == "history" %>
  <%= render "history" %>
<% elsif @tab == "synchronization" %>
  <%= render "synchronization" %>
<% else %>
  <% adapter = @adapters.find { |entry| entry.key == @tab } %>
  <% if adapter.is_a?(RedmineMirror::Adapters::ProjectReferences) %>
    <p><%= l(:text_mirror_reference_objects) %> <%= link_to l(:label_mirror_objects), project_mirror_settings_path(@project, tab: "objects", module_key: adapter.key) %></p>
  <% end %>
  <%= render "pending_parents" if adapter.key == "issue_hierarchy" %>
  <%= render "pending_relations" if adapter.key == "issue_relations" %>
  <%= render adapter.settings_partial, adapter: adapter if adapter.settings_partial %>
  <% if %w[issue_hierarchy issue_watchers].include?(adapter.key) %>
    <p><%= l("text_mirror_#{adapter.key}".to_sym) %></p>
    <p><%= link_to l(:label_mirror_module_users), project_mirror_settings_path(@project, tab: "users") %></p>
  <% end %>
  <p><%= l(:text_mirror_mapping_help) %></p>
  <%= form_tag project_mirror_mappings_path(@project, module_key: adapter.key), method: :patch do %>
    <% adapter.mapping_tables.each do |table| %>
      <h3><%= l(table.label) %></h3>
      <table class="list mirror-mapping-table" id="mirror-table-<%= table.key %>">
        <thead><tr><th><%= l(:label_mirror_source) %></th><th><%= l(:label_mirror_destination) %></th></tr></thead>
        <tbody>
        <% local_choices = [[l(:label_mirror_unmapped), ""]] + table.local_records(@project).map { |record| ["#{record.name} (##{record.id})", record.id.to_s] } %>
        <% local_choices << [l(:label_mirror_ignore_field), "ignore"] if table.ignore_allowed? %>
        <% local_choices << [l(:label_mirror_anonymous), "anonymous"] if table.anonymous_allowed? %>
        <%# Only references used by the source project (and those already mapped), unless all are requested. %>
        <% used = @setting.source_catalog["#{table.key}_used"] %>
        <% rows = @setting.source_catalog.fetch(table.key, {}).sort_by { |id, name| [name.downcase, id.to_i] } %>
        <% hidden = used && params[:all_references] != "1" ? rows.reject { |id, _| used.include?(id) || @mapping_values[[table.key, id]].present? } : [] %>
        <% (rows - hidden).each do |id, name| %>
          <% selected = @mapping_values[[table.key, id]] %>
          <% choices = local_choices.dup %>
          <% choices << [l(:label_mirror_invalid_destination), selected] if selected.present? && choices.none? { |choice| choice.last == selected } %>
          <tr><td><%= name %> (#<%= mirror_object_link(table.key, id, source_url: @setting.source_url) %>)</td><td>
            <%= label_tag "mirror-#{table.key}-#{id}", l(:label_mirror_destination), class: "hidden-for-sighted" %>
            <%= select_tag "mappings[#{table.key}][#{id}]", options_for_select(choices, selected), id: "mirror-#{table.key}-#{id}",
              class: "mirror-autocomplete", data: { placeholder: l(:label_mirror_type_to_search) } %>
            <%= mirror_object_link(table.key, selected) if selected.present? && !%w[anonymous ignore].include?(selected) %>
          </td></tr>
        <% end %>
        </tbody>
      </table>
      <% if @setting.source_catalog.fetch(table.key, {}).empty? %><p class="nodata"><%= l(:label_no_data) %></p><% end %>
      <% if hidden.any? %><p class="mirror-unused-references"><%= link_to l(:label_mirror_show_unused_references, count: hidden.size), project_mirror_settings_path(@project, tab: adapter.key, all_references: 1) %></p><% end %>
    <% end %>
    <%= render "custom_field_values", adapter: adapter if adapter.key == "issue_custom_fields" %>
    <% if adapter.key == "issue_relations" %>
      <p><%= label_tag :missing_target, l(:label_mirror_missing_relation) %>
      <%= select_tag "module_options[missing_target]", options_for_select([[l(:label_mirror_relation_ignore), "ignore"], [l(:label_mirror_relation_note), "note"]], @setting.module_options.dig(adapter.key, "missing_target") || "ignore"), id: "missing_target" %></p>
    <% end %>
    <% if adapter.anonymous_time_user_required? %>
      <div class="box tabular"><p>
        <%= label_tag "anonymous-time-user", l(:label_mirror_anonymous_time_user) %>
        <%= select_tag "module_options[anonymous_user_id]", options_for_select([[l(:label_mirror_unmapped), ""]] + @project.users.active.sorted.map { |user| [user.name, user.id] }, @setting.module_options.dig(adapter.key, "anonymous_user_id")), id: "anonymous-time-user" %>
        <em class="info"><%= l(:text_mirror_anonymous_time_user) %></em>
      </p></div>
    <% end %>
    <%= submit_tag l(:button_save) %>
  <% end %>
<% end %>
