Warn about a queued execution that no worker has picked up, and allow withdrawing it.
%><div id="mirror-queued-run">
  <% if run.stalled_in_queue? %>
    <p class="warning"><%= l(:text_mirror_queue_stalled, minutes: (MirrorSyncRun::QUEUE_WARNING_DELAY / 60).to_i) %></p>
  <% end %>
  <%= button_to l(:button_mirror_cancel_run), project_mirror_run_cancel_path(@project, run), method: :patch,
        data: { confirm: l(:text_are_you_sure) } %>
</div>
