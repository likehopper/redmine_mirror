Options of the Repositories module, inside its tab's form: path rewrites, credentials
and whether the run reads the revisions.
%><% options = @setting.module_options.fetch("repositories", {}) %>
<p><%= l(:text_mirror_repositories) %></p>
<div class="box tabular" id="mirror-repositories-options">
  <p><%= label_tag "repositories-path-rewrites", l(:label_mirror_repositories_path_rewrites) %>
    <%= text_area_tag "module_options[path_rewrites]", options["path_rewrites"], rows: 3, cols: 60, id: "repositories-path-rewrites",
          placeholder: "/var/lib/redmine/git => /srv/git" %>
    <em class="info"><%= l(:text_mirror_repositories_path_rewrites) %></em></p>
  <p><%= label_tag "repositories-credentials", l(:label_mirror_repositories_credentials) %>
    <%= hidden_field_tag "module_options[credentials]", "0", id: nil %>
    <%= check_box_tag "module_options[credentials]", "1", options["credentials"] == "1", id: "repositories-credentials" %>
    <em class="info"><%= l(:text_mirror_repositories_credentials) %></em></p>
  <p><%= label_tag "repositories-fetch", l(:label_mirror_repositories_fetch) %>
    <%= hidden_field_tag "module_options[fetch_changesets]", "0", id: nil %>
    <%= check_box_tag "module_options[fetch_changesets]", "1", options["fetch_changesets"] != "0", id: "repositories-fetch" %>
    <em class="info"><%= l(:text_mirror_repositories_fetch) %></em></p>
</div>
