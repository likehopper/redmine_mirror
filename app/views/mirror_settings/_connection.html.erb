Connection: source Redmine and project, API key, source text format and modules.
%><% admin = User.current.admin? %>
<% allowed = RedmineMirror.allowed_source_urls %>
<% unless @setting.persisted? %>
  <p><%= l(:text_mirror_connection_intro) %></p>
<% end %>
<% if @setting.persisted? && (checklist = mirror_checklist(@project, @setting)).any? %>
  <%= render "mirror/checklist", checklist: checklist %>
<% end %>
<%= form_tag project_mirror_connection_path(@project), method: :patch, id: "mirror-connection-form" do %>
  <div class="box tabular">
    <p><%= label_tag "connection_source_url", l(:label_mirror_source_url), class: "required" %>
      <% if @setting.persisted? %>
        <%= text_field_tag "connection[source_url]", @setting.source_url, size: 60, readonly: true %>
        <em class="info"><%= l(:text_mirror_source_fixed) %></em>
      <% elsif allowed.any? %>
        <%# Once sources are allowed, everyone chooses among them, administrators included. %>
        <%= select_tag "connection[source_url]", options_for_select(allowed, @setting.source_url), id: "connection_source_url" %>
        <% if admin %><em class="info"><%= l(:text_mirror_source_admin, link: link_to(l(:label_mirror_plugin_settings), plugin_settings_path(id: "redmine_mirror"))).html_safe %></em><% end %>
      <% elsif admin %>
        <%# No allowed list yet: an administrator may still try any source. %>
        <%= text_field_tag "connection[source_url]", @setting.source_url, size: 60, placeholder: "https://redmine.example.com" %>
        <em class="info"><%= l(:text_mirror_source_admin_free, link: link_to(l(:label_mirror_plugin_settings), plugin_settings_path(id: "redmine_mirror"))).html_safe %></em>
      <% else %>
        <span class="warning" id="mirror-no-allowed-source"><%= l(:text_mirror_no_allowed_source) %></span>
      <% end %></p>
    <p><%= label_tag "connection_source_project_id", l(:label_mirror_source_project), class: "required" %><%= text_field_tag "connection[source_project_id]", @setting.source_project_identifier.presence || @setting.source_project_id, size: 30, placeholder: "my-project" %>
      <em class="info"><%= @setting.source_project_id ? l(:text_mirror_source_project_number, id: @setting.source_project_id) : l(:text_mirror_source_project_help) %></em></p>
    <p><%= label_tag "connection_api_key", l(:label_mirror_api_key), class: (@setting.persisted? ? nil : "required") %><%= password_field_tag "connection[api_key]", nil, autocomplete: "new-password" %>
      <em class="info"><%= @setting.persisted? ? l(:text_mirror_keep_api_key) : l(:text_mirror_api_key_account) %></em></p>
    <p><%= label_tag "connection_source_text_format", l(:label_mirror_source_text_format) %>
      <%= select_tag "connection[source_text_format]", options_for_select(RedmineMirror::TextFormat::SOURCE_FORMATS.map { |format| [l("label_mirror_text_format_#{format}"), format] }, @setting.source_text_format), id: "connection_source_text_format" %>
      <em class="info" id="mirror-text-formats"><%= l(:text_mirror_destination_text_format, name: mirror_text_format_name(RedmineMirror::TextFormat.destination_format(@project))) %>
        <% if (counts = @setting.source_catalog["text_formats"]).present? %>
          <%= l(:text_mirror_detected_text_formats, formats: counts.sort_by { |_, count| -count.to_i }.map { |format, count| "#{l("label_mirror_text_format_#{format}")} #{count}" }.join(", ")) %>
        <% end %></em></p>
    <%# The modules are chosen once the connection is saved and the source modules known. %>
    <% if !@setting.persisted? %>
    <p id="mirror-modules-after-save"><label><%= l(:label_mirror_modules) %></label><em class="info"><%= l(:text_mirror_modules_after_save) %></em></p>
    <% else %>
    <% if @setting.selected_modules.empty? %>
      <p class="warning" id="mirror-no-module-selected"><%= l(:text_mirror_no_module_selected) %></p>
    <% end %>
    <p><label><%= l(:label_mirror_modules) %></label>
      <%= hidden_field_tag "connection[modules][]", "" %>
      <% source_modules = @setting.source_catalog["source_modules"] %>
      <% RedmineMirror::REGISTRY.resolve(RedmineMirror::REGISTRY.keys).select(&:selectable?).each do |adapter| %>
        <% next unless adapter.available? || @setting.selected_modules.include?(adapter.key) %>
        <% source_off = source_modules && adapter.source_project_module && !source_modules.include?(adapter.source_project_module.to_s) %>
        <%# The connection check (mirror.js) marks the modules again from data-source-module. %>
        <%= content_tag :label, class: "block#{' mirror-module-source-off' if source_off}", data: { source_module: adapter.source_project_module } do %><%= check_box_tag "connection[modules][]", adapter.key, @setting.selected_modules.include?(adapter.key), id: "connection_modules_#{adapter.key}" %> <%= l(adapter.label) %><% if adapter.respond_to?(:selection_hint) && adapter.selection_hint %> <em class="info mirror-module-hint"><%= l(adapter.selection_hint) %></em><% end %><% if adapter.source_project_module %> <em class="info mirror-module-hint mirror-module-off-hint"<%= ' style="display:none"'.html_safe unless source_off %>><%= l(:text_mirror_module_off_on_source) %></em><% end %><% end %>
      <% end %>
      <em class="info"><%= l(:text_mirror_modules_help) %></em></p>
    <% if @setting.unavailable_modules.any? %>
      <p id="mirror-unavailable-modules" class="warning"><%= l(:text_mirror_unavailable_modules, modules: @setting.unavailable_modules.map { |key| mirror_module_label(key) }.join(", ")) %></p>
    <% end %>
    <% end %>
  </div>
  <% no_source = !@setting.persisted? && !admin && allowed.empty? %>
  <%= submit_tag l(:button_save), disabled: no_source %>
  <%= button_tag l(:button_mirror_connection_check), type: "button", id: "mirror-connection-check", disabled: no_source,
    data: { url: project_mirror_connection_check_path(@project), checking: l(:text_mirror_connection_checking) } %>
  <div id="mirror-connection-check-result" aria-live="polite"></div>
<% end %>
<% if @setting.persisted? %>
  <%= button_to l(:button_mirror_refresh), project_mirror_refresh_path(@project), method: :post, disabled: @setting.catalog_refreshing? %>
  <p><em class="info"><%= l(:text_mirror_refresh_help) %></em></p>
  <%# Shown even without administrator defaults: users have a built-in fallback. %>
  <% ready = [nil, "ready"].include?(@setting.catalog_status) %>
  <h3 id="mirror-project-defaults-title"><%= l(:label_mirror_admin_defaults) %></h3>
  <div class="box" id="mirror-project-defaults">
    <%= form_tag project_mirror_defaults_path(@project), method: :patch, id: "mirror-project-defaults-form" do %>
      <p><%= hidden_field_tag :use_default_mappings, "0", id: nil %>
        <label><%= check_box_tag :use_default_mappings, "1", @setting.use_default_mappings, id: "mirror-use-default-mappings" %> <%= l(:label_mirror_use_default_mappings) %></label>
        <%= submit_tag l(:button_save), name: nil %><br>
        <em class="info"><%= l(:text_mirror_use_default_mappings, count: @project.mirror_reference_mappings.where(from_default: true).count) %></em></p>
    <% end %>
    <p><%= button_to l(:button_mirror_project_defaults_apply), project_mirror_defaults_apply_path(@project), method: :post, disabled: !ready, form_class: "mirror-inline-form", id: "mirror-project-defaults-apply" %>
      <%= button_to l(:button_mirror_project_defaults_reset), project_mirror_defaults_apply_path(@project, reset: "1"), method: :post, disabled: !ready, form_class: "mirror-inline-form",
        id: "mirror-project-defaults-reset", data: { confirm: l(:text_mirror_project_defaults_reset_confirm) } %><br>
      <em class="info"><%= l(:text_mirror_project_defaults_buttons) %></em></p>
  </div>
<% end %>
