Administration > Mirror > Default correspondences (doc/DEFAULT_MAPPINGS.md): one tab per
reference table and one for the list values of a local custom field. Adding, importing
and the CSV export are separate pages or links.
%><% content_for :header_tags do %>
  <%= stylesheet_link_tag "mirror", plugin: "redmine_mirror" %>
<% end %>
<% html_title(l(:label_mirror_admin_defaults)) %>
<%= render "mirror_admin/sidebar" %>
<div class="contextual" id="mirror-defaults-tools">
  <%= link_to l(:label_mirror_defaults_import), mirror_admin_defaults_import_form_path, class: "icon icon-import" %>
  <%= link_to l(:button_mirror_defaults_export), mirror_admin_defaults_path(format: "csv"), class: "icon icon-download" %>
</div>
<h2><%= link_to l(:label_mirror_admin), mirror_admin_path %> » <%= l(:label_mirror_admin_defaults) %></h2>
<p class="info"><%= l(:text_mirror_admin_defaults) %></p>
<p><%= button_to l(:button_mirror_defaults_apply), mirror_admin_defaults_apply_path, method: :post, form_class: "mirror-inline-form", id: "mirror-defaults-apply" %>
  <em class="info"><%= l(:text_mirror_defaults_apply) %></em></p>
<% types = (MirrorDefaultMapping::TYPES - ["custom_field_value"]).select { |type| MirrorDefaultMapping.table(type) } %>
<% tabs = types.map { |type| { name: type, partial: "mirror_admin/defaults_tab", label: MirrorDefaultMapping.table(type).label } } %>
<% tabs << { name: "custom_field_value", partial: "mirror_admin/defaults_values_tab", label: :label_mirror_default_values } %>
<%= render_tabs tabs, params[:tab].presence_in(tabs.map { |tab| tab[:name] }) %>
