Rows of the administration overview, grouped and totalled as a Redmine query.
%><div class="autoscroll">
<table class="list odd-even mirror-admin-projects">
<thead><tr>
  <% @query.inline_columns.each do |column| %><%= column_header(@query, column) %><% end %>
</tr></thead>
<tbody>
<% grouped_query_results(settings, @query) do |setting, group_name, group_count, group_totals| %>
  <% if group_name %>
    <% reset_cycle %>
    <tr class="group open"><td colspan="<%= @query.inline_columns.size %>">
      <span class="name"><%= group_name %></span>
      <% if group_count %><span class="badge badge-count count"><%= group_count %></span><% end %>
      <span class="totals"><%= group_totals %></span>
    </td></tr>
  <% end %>
  <tr class="<%= cycle("odd", "even") %>">
    <% @query.inline_columns.each do |column| %>
      <%= content_tag("td", mirror_admin_column_content(column, setting), class: column.css_classes) %>
    <% end %>
  </tr>
<% end %>
</tbody>
</table>
</div>
