Administration overview of the projects Mirror is configured in (Redmine query list).
%><% content_for :header_tags do %>
  <%= stylesheet_link_tag "mirror", plugin: "redmine_mirror" %>
<% end %>
<% html_title(l(:label_mirror_admin)) %>
<%= render "mirror_admin/sidebar" %>
<h2><%= l(:label_mirror_admin) %></h2>
<p class="info"><%= l(:text_mirror_admin, days: MirrorProjectQuery::RECENT_DAYS) %></p>

<div class="mirror-admin-query">
<%= form_tag(mirror_admin_path, method: :get, id: "query_form") do %>
  <%= render partial: "queries/query_form" %>
<% end %>
</div>

<% if @query.valid? %>
  <% if @settings.empty? %>
    <p class="nodata"><%= l(:label_no_data) %></p>
  <% else %>
    <%= render_query_totals(@query) %>
    <%= render partial: "mirror_admin/list", locals: { settings: @settings } %>
    <span class="pagination"><%= pagination_links_full @setting_pages, @setting_count %></span>
  <% end %>
  <% other_formats_links do |f| %>
    <%= f.link_to_with_query_parameters "CSV" %>
  <% end %>
<% end %>
